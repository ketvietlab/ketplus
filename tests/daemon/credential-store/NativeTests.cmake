# Included by the main test tree and the focused credential-storage build.
if(APPLE)
    add_executable(ketplus_credential_keychain_probe "${CMAKE_CURRENT_LIST_DIR}/KeychainProbe.cpp")
    target_link_libraries(ketplus_credential_keychain_probe PRIVATE ${CREDENTIAL_STORAGE_LIBRARY})
    add_executable(ketplus_credential_keychain_tests "${CMAKE_CURRENT_LIST_DIR}/KeychainTest.cpp")
    target_link_libraries(ketplus_credential_keychain_tests PRIVATE ${CREDENTIAL_STORAGE_LIBRARY} Qt6::Test)
    target_compile_definitions(ketplus_credential_keychain_tests PRIVATE
        KEYCHAIN_PROBE="$<TARGET_FILE:ketplus_credential_keychain_probe>")
    add_dependencies(ketplus_credential_keychain_tests ketplus_credential_keychain_probe)
    add_test(NAME ketplus_credential_keychain_tests COMMAND ketplus_credential_keychain_tests)
endif()
if(APPLE OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(Qt6 6.11 QUIET COMPONENTS DBus)
    find_program(DBUS_DAEMON dbus-daemon)
    if(TARGET Qt6::DBus AND DBUS_DAEMON)
        if(APPLE AND NOT CREDENTIAL_STORAGE_INCLUDES_SECRET_SERVICE)
            add_library(credential_secret_service_adapter STATIC
                "${PROJECT_SOURCE_DIR}/modules/remote/src/cloud/SecretServiceCredentialBackend.cpp")
            target_link_libraries(credential_secret_service_adapter PUBLIC ketplus_control_crypto Qt6::DBus)
            set(CREDENTIAL_SECRET_LIBRARY credential_secret_service_adapter)
        else()
            set(CREDENTIAL_SECRET_LIBRARY ${CREDENTIAL_STORAGE_LIBRARY})
        endif()
        add_executable(ketplus_credential_secret_service_fixture "${CMAKE_CURRENT_LIST_DIR}/SecretServiceFixture.cpp")
        target_link_libraries(ketplus_credential_secret_service_fixture PRIVATE ${CREDENTIAL_SECRET_LIBRARY} Qt6::DBus)
        add_executable(ketplus_credential_secret_service_tests "${CMAKE_CURRENT_LIST_DIR}/SecretServiceTest.cpp")
        target_link_libraries(ketplus_credential_secret_service_tests PRIVATE ${CREDENTIAL_SECRET_LIBRARY} Qt6::Test Qt6::DBus)
        target_compile_definitions(ketplus_credential_secret_service_tests PRIVATE
            SECRET_SERVICE_FIXTURE="$<TARGET_FILE:ketplus_credential_secret_service_fixture>"
            DBUS_DAEMON="${DBUS_DAEMON}")
        add_dependencies(ketplus_credential_secret_service_tests ketplus_credential_secret_service_fixture)
        add_test(NAME ketplus_credential_secret_service_tests COMMAND ketplus_credential_secret_service_tests)
    else()
        message(WARNING "Secret Service fixtures require Qt DBus and dbus-daemon; this platform coverage is unavailable")
    endif()
endif()
