cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/KetPlusProductionControl.cmake")
if(DEFINED CASE)
    set(prod_url "https://api.ketplus.app")
    set(staging_url "https://staging.example.invalid")
    if(CASE STREQUAL configure_production)
        set(KETPLUS_PRODUCTION_RELEASE ON)
        ketplus_configure_production_control()
        if(NOT KETPLUS_CONTROL_URL STREQUAL prod_url)
            message(FATAL_ERROR "Production configure did not resolve the production URL")
        endif()
    elseif(CASE STREQUAL configure_wrong)
        set(KETPLUS_PRODUCTION_RELEASE ON)
        set(KETPLUS_CONTROL_URL "${staging_url}")
        ketplus_configure_production_control()
    elseif(CASE STREQUAL configure_developer)
        set(KETPLUS_PRODUCTION_RELEASE OFF)
        set(KETPLUS_CONTROL_URL "${staging_url}")
        ketplus_configure_production_control()
        if(NOT KETPLUS_CONTROL_URL STREQUAL staging_url)
            message(FATAL_ERROR "Developer relay changed")
        endif()
    else()
        set(url "${prod_url}")
        set(overridable false)
        set(production ON)
        set(expected "${prod_url}")
        if(CASE STREQUAL reject_staging)
            set(url "${staging_url}")
        elseif(CASE STREQUAL reject_loopback)
            set(url "http://127.0.0.1:9123")
        elseif(CASE STREQUAL reject_override)
            set(overridable true)
        elseif(CASE STREQUAL reject_expected)
            set(expected "${staging_url}")
        elseif(CASE STREQUAL accept_debug)
            set(url "http://127.0.0.1:9123")
            set(overridable true)
            set(production OFF)
        endif()
        set(info "{\"control_url\":\"${url}\",\"control_url_overridable\":${overridable}}")
        if(CASE STREQUAL reject_missing)
            set(info "{}")
        endif()
        ketplus_verify_control_build_info("${info}" "${expected}" "${production}")
    endif()
    return()
endif()

foreach(case configure_production configure_developer accept_production accept_debug
             configure_wrong reject_staging reject_loopback reject_override reject_expected reject_missing)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case MATCHES "^(reject_|configure_wrong)")
        if(result EQUAL 0 OR NOT error MATCHES "Production|Bundled daemon|Unreadable daemon")
            message(FATAL_ERROR "${case}: expected a control policy rejection: ${output} ${error}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${case}: ${output} ${error}")
    endif()
    message(STATUS "${case}: passed")
endforeach()
