include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/KetPlusMacPackageArchitecture.cmake")
set(CMAKE_SYSTEM_PROCESSOR arm64)
foreach(target IN ITEMS arm64 x86_64 "arm64;x86_64")
    set(CMAKE_OSX_ARCHITECTURES "${target}")
    ketplus_mac_package_architecture(actual)
    list(JOIN CMAKE_OSX_ARCHITECTURES "-" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Target ${target} was labelled ${actual}, expected ${expected}")
    endif()
endforeach()
unset(CMAKE_OSX_ARCHITECTURES)
ketplus_mac_package_architecture(actual)
if(NOT actual STREQUAL CMAKE_SYSTEM_PROCESSOR)
    message(FATAL_ERROR "A native build without an explicit arch lost its processor fallback")
endif()
message(STATUS "Mac package architecture: 4/4 cases passed")
