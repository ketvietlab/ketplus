# Preserve these upstream MIT license copies byte-for-byte, including their final blank line.
/third_party/licenses/Solarized-MIT.txt whitespace=-blank-at-eof
/core/third_party/licenses/Solarized-MIT.txt whitespace=-blank-at-eof

# cmd.exe reads batch files unreliably with LF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
