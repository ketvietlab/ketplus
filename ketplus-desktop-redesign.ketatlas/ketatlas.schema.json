{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KetAtlas configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4096
        }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "pattern": "\\S"
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 160,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 160,
                "maximum": 4096
              }
            },
            "required": ["width", "height"],
            "additionalProperties": false
          },
          "description": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          }
        },
        "required": ["id", "title", "url"],
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "ends": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "screen": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "type": {
                  "enum": ["screen", "note", "external"]
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "row": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
                },
                "label": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "kind": {
                  "enum": ["primary", "conditional", "recovery"]
                }
              },
              "required": ["from", "to", "label"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "title", "nodes", "edges"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "title", "flows"],
  "additionalProperties": false
}
