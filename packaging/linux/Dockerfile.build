FROM node:24-bookworm-slim AS node
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
ARG KETPLUS_DESKTOP=0
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git python3-venv ca-certificates patchelf \
    libssl-dev libgl1-mesa-dev libfontconfig1 libfreetype6 libdbus-1-3 \
    libxkbcommon0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-render-util0 libxcb-xinerama0 libxcb-xkb1 libegl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
# The daemon-only image keeps its small dependency set by default. Desktop packaging also
# needs the WebEngine runtime, Xvfb smoke tools and the Debian/AppImage assembly tools.
RUN if [ "$KETPLUS_DESKTOP" = 1 ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        libnss3 libasound2t64 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 \
        libxi6 libxrandr2 libxss1 libxtst6 libxshmfence1 libgbm1 libdrm2 \
        libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        xvfb xauth fonts-dejavu-core xdg-utils file dpkg-dev squashfs-tools \
        desktop-file-utils && rm -rf /var/lib/apt/lists/*; \
    fi
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
RUN python3 -m venv /opt/aqt && /opt/aqt/bin/pip install --no-cache-dir aqtinstall==3.3.0
ARG TARGETARCH
ARG QT_MODULES=qtwebsockets
RUN case "$TARGETARCH" in \
      amd64) qt_platform=linux; qt_arch=linux_gcc_64; qt_directory=gcc_64 ;; \
      arm64) qt_platform=linux_arm64; qt_arch=linux_gcc_arm64; qt_directory=gcc_arm64 ;; \
      *) echo "Unsupported Linux Qt architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    /opt/aqt/bin/aqt install-qt "$qt_platform" desktop 6.11.1 "$qt_arch" -O /opt/qt -m $QT_MODULES && \
    ln -s "/opt/qt/6.11.1/$qt_directory" /opt/qt/current
ENV QT_ROOT=/opt/qt/current
ENV QT_QPA_PLATFORM=offscreen
WORKDIR /src
