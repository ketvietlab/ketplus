FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git libgl1 libopengl0 libegl1 libfontconfig1 libfreetype6 \
    libglib2.0-0 libdbus-1-3 libxkbcommon0 binutils systemd && \
    rm -rf /var/lib/apt/lists/*
COPY verify-installed-runtime.sh /usr/local/bin/verify-ketplus-runtime
RUN chmod 0755 /usr/local/bin/verify-ketplus-runtime
ENV KETPLUS_RUNTIME_FIXTURE=1
ENV LANG=C.UTF-8
ENTRYPOINT ["/usr/local/bin/verify-ketplus-runtime"]
CMD ["/runtime"]
