# Writes Qt-Third-Party-Notices.txt for the Qt libraries a staged Windows tree actually carries
# (docs/licensing.md, "Required distribution files"). The text comes from the SBOM the Qt build
# installs beside the libraries (<Qt>/sbom/<repository>-<version>.spdx): for every staged Qt6<Name>
# library, the repository that defines module <Name> contributes the bundled third-party libraries
# and attribution entries it lists. Granularity is the repository, so an entry may name a library
# whose code the tree does not use; nothing the tree uses is left out.
#
# Run at install time:  -DSTAGE=<install prefix> -DQT_SBOM_DIR=<Qt>/sbom -P QtNotices.cmake
if(NOT STAGE OR NOT IS_DIRECTORY "${STAGE}/bin")
    message(FATAL_ERROR "Pass -DSTAGE=<install prefix>")
endif()
if(NOT QT_SBOM_DIR OR NOT IS_DIRECTORY "${QT_SBOM_DIR}")
    message(FATAL_ERROR
        "The Qt SBOM directory was not found (${QT_SBOM_DIR}). The Qt installation must include "
        "its sbom/ folder to produce Qt-Third-Party-Notices.txt.")
endif()

# Plugins that come from a repository with no Qt6<Name>.dll of its own.
set(plugin_repository_qtimageformats qwebp qtiff qicns qtga qwbmp)

file(GLOB staged_libraries RELATIVE "${STAGE}/bin" "${STAGE}/bin/Qt6*.dll")
set(wanted_modules "")
foreach(library IN LISTS staged_libraries)
    string(REGEX REPLACE "^Qt6(.*)\\.dll$" "\\1" module "${library}")
    list(APPEND wanted_modules "${module}")
endforeach()
file(GLOB staged_plugins RELATIVE "${STAGE}/plugins/imageformats" "${STAGE}/plugins/imageformats/*.dll")
set(wanted_repositories "")
foreach(plugin IN LISTS staged_plugins)
    get_filename_component(plugin_name "${plugin}" NAME_WE)
    if(plugin_name IN_LIST plugin_repository_qtimageformats)
        list(APPEND wanted_repositories qtimageformats)
    endif()
endforeach()

file(GLOB sbom_documents "${QT_SBOM_DIR}/*.spdx")
list(FILTER sbom_documents EXCLUDE REGEX "\\.source\\.spdx$")
set(notice "Qt third-party notices\n\n")
string(APPEND notice
    "The Qt libraries in this distribution are used under the LGPL 3.0 (Qt-LGPL-3.0.txt; "
    "GPL-3.0.txt is the text it refers to). The following components are bundled in the Qt "
    "repositories they come from. This list is generated from the SBOM of the Qt build that was "
    "deployed.\n")
set(seen_entries "")
set(listed_repositories "")
foreach(document IN LISTS sbom_documents)
    get_filename_component(document_name "${document}" NAME_WE)
    string(REGEX REPLACE "-[0-9.]+$" "" repository "${document_name}")
    file(READ "${document}" content)
    set(needed FALSE)
    if(repository IN_LIST wanted_repositories)
        set(needed TRUE)
    endif()
    foreach(module IN LISTS wanted_modules)
        if(content MATCHES "\nSPDXID: SPDXRef-Package-${repository}-qt-module-${module}-")
            set(needed TRUE)
        endif()
    endforeach()
    if(NOT needed)
        continue()
    endif()
    list(APPEND listed_repositories "${repository}")
    string(APPEND notice "\n== ${repository} ==\n")
    string(REGEX MATCHALL "\nPackageName: [A-Za-z0-9_]*(Attribution_|Bundled)[A-Za-z0-9_]*\n"
        entries "${content}")
    foreach(entry IN LISTS entries)
        string(STRIP "${entry}" entry_line)
        string(REPLACE "PackageName: " "" entry_name "${entry_line}")
        if(entry_name MATCHES "Private$")
            continue()
        endif()
        string(FIND "${content}" "${entry}" start)
        string(SUBSTRING "${content}" ${start} 6000 block)
        string(FIND "${block}" "\n\nPackageName:" block_end)
        if(NOT block_end EQUAL -1)
            string(SUBSTRING "${block}" 0 ${block_end} block)
        endif()
        set(title "${entry_name}")
        if(block MATCHES "\n    Name: ([^\n]+)")
            set(title "${CMAKE_MATCH_1}")
        endif()
        set(version "")
        if(block MATCHES "\nPackageVersion: ([^\n]+)" AND NOT CMAKE_MATCH_1 STREQUAL "unknown")
            set(version " ${CMAKE_MATCH_1}")
        endif()
        set(license "NOASSERTION")
        if(block MATCHES "\nPackageLicenseConcluded: ([^\n]+)")
            set(license "${CMAKE_MATCH_1}")
        endif()
        set(copyright "")
        if(block MATCHES "\nPackageCopyrightText: (<text>)?([^\n]*)")
            string(REPLACE "</text>" "" copyright "${CMAKE_MATCH_2}")
        endif()
        set(source "")
        if(block MATCHES "\nPackageDownloadLocation: ([^\n]+)")
            set(source "${CMAKE_MATCH_1}")
        endif()
        if("${repository}|${title}${version}" IN_LIST seen_entries)
            continue()
        endif()
        list(APPEND seen_entries "${repository}|${title}${version}")
        string(APPEND notice "\n${title}${version}\n  License: ${license}\n")
        if(copyright AND NOT copyright STREQUAL "NOASSERTION")
            string(APPEND notice "  ${copyright}\n")
        endif()
        if(source AND NOT source STREQUAL "NOASSERTION")
            string(APPEND notice "  Source: ${source}\n")
        endif()
    endforeach()
endforeach()
if(NOT listed_repositories)
    message(FATAL_ERROR "No Qt SBOM document matches the Qt libraries staged under ${STAGE}/bin")
endif()
file(MAKE_DIRECTORY "${STAGE}/share/licenses/ketplus")
file(WRITE "${STAGE}/share/licenses/ketplus/Qt-Third-Party-Notices.txt" "${notice}")
message(STATUS "Qt-Third-Party-Notices.txt: ${listed_repositories}")
