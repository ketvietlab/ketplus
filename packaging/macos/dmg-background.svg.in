<svg xmlns="http://www.w3.org/2000/svg" width="1320" height="840" viewBox="0 0 660 420">
  <defs>
    <linearGradient id="surface" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b1120"/>
      <stop offset="0.55" stop-color="#111a30"/>
      <stop offset="1" stop-color="#080d18"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.42" r="0.62">
      <stop offset="0" stop-color="#5277ff" stop-opacity="0.28"/>
      <stop offset="0.5" stop-color="#3158e8" stop-opacity="0.09"/>
      <stop offset="1" stop-color="#10182d" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="brand" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6d8cff"/>
      <stop offset="1" stop-color="#4167f5"/>
    </linearGradient>
    <linearGradient id="arrow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7692ff" stop-opacity="0.35"/>
      <stop offset="0.5" stop-color="#7692ff"/>
      <stop offset="1" stop-color="#93a8ff"/>
    </linearGradient>
    <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0V24" fill="none" stroke="#8da2d8" stroke-opacity="0.035" stroke-width="1"/>
    </pattern>
    <filter id="blur" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="24"/>
    </filter>
    <filter id="shadow" x="-40%" y="-40%" width="180%" height="180%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000713" flood-opacity="0.5"/>
    </filter>
  </defs>

  <rect width="660" height="420" fill="url(#surface)"/>
  <rect width="660" height="420" fill="url(#grid)"/>
  <ellipse cx="330" cy="190" rx="280" ry="210" fill="url(#glow)"/>
  <circle cx="90" cy="42" r="92" fill="#456dff" opacity="0.09" filter="url(#blur)"/>
  <circle cx="590" cy="390" r="120" fill="#263f95" opacity="0.11" filter="url(#blur)"/>

  <g transform="translate(34 28)">
    <rect width="30" height="30" rx="8" fill="#111b33" stroke="#7290ff" stroke-opacity="0.35"/>
    <path d="M8 8.5L14.8 4.5L21.6 8.5L14.8 12.5Z" fill="url(#brand)"/>
    <path d="M8 11.5L13 14.4V20.3L8 23.2Z" fill="url(#brand)"/>
    <path d="M14.8 18L21.6 22L14.8 26L10.6 23.5L16 20.3V16.7Z" fill="#27437f"/>
    <path d="M21.1 12.4V15H18.5V18.4H21.1V21H24.5V18.4H27.1V15H24.5V12.4Z" fill="url(#brand)"/>
    <text x="42" y="21" fill="#f5f7ff" font-family="Helvetica Neue, Helvetica, sans-serif"
          font-size="17" font-weight="600" letter-spacing="-0.2">KetPlus</text>
  </g>

  <text x="330" y="92" text-anchor="middle" fill="#f6f8ff"
        font-family="Helvetica Neue, Helvetica, sans-serif" font-size="29" font-weight="600"
        letter-spacing="-0.7">Install KetPlus</text>
  <text x="330" y="119" text-anchor="middle" fill="#9da9c4"
        font-family="Helvetica Neue, Helvetica, sans-serif" font-size="14" font-weight="400">
    Drag KetPlus into Applications
  </text>

  <g filter="url(#shadow)">
    <rect x="101" y="158" width="138" height="138" rx="34" fill="#111b31" fill-opacity="0.72"
          stroke="#7692ff" stroke-opacity="0.18"/>
    <rect x="421" y="158" width="138" height="138" rx="34" fill="#111b31" fill-opacity="0.72"
          stroke="#7692ff" stroke-opacity="0.18"/>
  </g>

  <path d="M270 225H378" fill="none" stroke="url(#arrow)" stroke-width="4"
        stroke-linecap="round"/>
  <path d="M369 214L382 225L369 236" fill="none" stroke="#91a6ff" stroke-width="4"
        stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="270" cy="225" r="4" fill="#7692ff" opacity="0.7"/>

  <g transform="translate(248 356)">
    <rect width="164" height="30" rx="15" fill="#18233e" stroke="#718cff" stroke-opacity="0.18"/>
    <circle cx="18" cy="15" r="4" fill="#6f8cff"/>
    <text x="31" y="20" fill="#b4bfd8" font-family="Helvetica Neue, Helvetica, sans-serif"
          font-size="12" font-weight="500">One app · Safe updates</text>
  </g>
  <text x="626" y="392" text-anchor="end" fill="#65718e"
        font-family="Helvetica Neue, Helvetica, sans-serif" font-size="11">
    Version @PROJECT_VERSION@
  </text>
</svg>
