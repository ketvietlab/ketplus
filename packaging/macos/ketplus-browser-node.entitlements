<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for Contents/Resources/ketplus-browser/bin/node only (ADR 0009).
  CMake does not sign; the release signing pipeline must apply this file to node.
  V8 generates machine code at runtime, so a hardened-runtime signature needs
  JIT. These match the entitlements Node.js uses for its own notarized builds.
  Do not apply them to KetPlus or ketplus_daemon.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
