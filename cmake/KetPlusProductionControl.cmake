# Production packaging opts in explicitly; ordinary developer/QA builds retain
# the staging default in CMakeLists.txt and may use an explicit loopback relay.
function(ketplus_configure_production_control)
    option(KETPLUS_PRODUCTION_RELEASE "Build packages for the production control service" OFF)
    if(KETPLUS_PRODUCTION_RELEASE)
        if(DEFINED KETPLUS_CONTROL_URL AND NOT KETPLUS_CONTROL_URL STREQUAL "https://api.ketplus.app")
            message(FATAL_ERROR "Production releases require KETPLUS_CONTROL_URL=https://api.ketplus.app")
        endif()
        set(KETPLUS_CONTROL_URL "https://api.ketplus.app" CACHE STRING
            "Relay (Control API) base URL compiled into the daemon" FORCE)
    endif()
endfunction()

function(ketplus_verify_control_build_info build_info expected_url production)
    if(production AND NOT expected_url STREQUAL "https://api.ketplus.app")
        message(FATAL_ERROR "Production bundle verification requires https://api.ketplus.app")
    endif()
    string(JSON bundled_url ERROR_VARIABLE json_error GET "${build_info}" control_url)
    if(json_error)
        message(FATAL_ERROR "Unreadable daemon control URL in build info")
    endif()
    string(JSON overridable ERROR_VARIABLE json_error GET "${build_info}" control_url_overridable)
    if(json_error)
        message(FATAL_ERROR "Unreadable daemon control override policy in build info")
    endif()
    if(production AND overridable)
        message(FATAL_ERROR "Production daemon must not allow control URL overrides")
    endif()
    if(NOT overridable AND NOT bundled_url STREQUAL expected_url)
        message(FATAL_ERROR "Bundled daemon talks to ${bundled_url}, expected ${expected_url}")
    endif()
endfunction()
