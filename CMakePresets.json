{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "KetPlus Pro development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "KETPLUS_EDITION": "pro",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "KETPLUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "KetPlus Pro release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "KETPLUS_EDITION": "pro",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "KETPLUS_BUILD_TESTS": "OFF",
        "KETPLUS_PRODUCTION_RELEASE": "ON"
      }
    },
    {
      "name": "release-macos-updates",
      "displayName": "KetPlus Pro macOS release with Sparkle updates",
      "inherits": "release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "binaryDir": "${sourceDir}/build/release-macos-updates/$env{KETPLUS_UPDATE_CHANNEL}/$env{KETPLUS_UPDATE_ARCH}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "$env{KETPLUS_UPDATE_ARCH}",
        "KETPLUS_REQUIRE_UPDATES": "ON",
        "KETPLUS_UPDATE_CHANNEL": "$env{KETPLUS_UPDATE_CHANNEL}",
        "KETPLUS_UPDATE_FEED_URL": "$env{KETPLUS_UPDATE_FEED_URL}",
        "KETPLUS_UPDATE_PUBLIC_ED_KEY": "$env{KETPLUS_UPDATE_PUBLIC_ED_KEY}"
      }
    },
    {
      "name": "daemon-dev",
      "displayName": "Headless daemon development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/daemon-dev",
      "cacheVariables": {
        "KETPLUS_EDITION": "pro",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "KETPLUS_BUILD_DESKTOP": "OFF",
        "KETPLUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "daemon-release",
      "inherits": "daemon-dev",
      "binaryDir": "${sourceDir}/build/daemon-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KETPLUS_BUILD_TESTS": "OFF",
        "KETPLUS_PRODUCTION_RELEASE": "ON"
      }
    },
    {
      "name": "lite-dev",
      "displayName": "KetPlus Lite development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/lite-dev",
      "cacheVariables": {
        "KETPLUS_EDITION": "lite",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "KETPLUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "lite-release",
      "inherits": "lite-dev",
      "displayName": "KetPlus Lite release",
      "binaryDir": "${sourceDir}/build/lite-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KETPLUS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-macos-updates",
      "configurePreset": "release-macos-updates"
    },
    {
      "name": "daemon-dev",
      "configurePreset": "daemon-dev"
    },
    {
      "name": "daemon-release",
      "configurePreset": "daemon-release"
    },
    {
      "name": "lite-dev",
      "configurePreset": "lite-dev"
    },
    {
      "name": "lite-release",
      "configurePreset": "lite-release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "daemon-dev",
      "configurePreset": "daemon-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "lite-dev",
      "configurePreset": "lite-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
