{
  "name": "@ketplus/browser-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone canonical browser and visual comparison prototype",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
