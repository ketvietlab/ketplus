{
  "theme": "base",
  "look": "classic",
  "startOnLoad": false,
  "securityLevel": "strict",
  "suppressErrorRendering": true,
  "htmlLabels": false,
  "maxTextSize": 30000,
  "maxEdges": 300,
  "secure": [
    "secure",
    "securityLevel",
    "startOnLoad",
    "theme",
    "themeVariables",
    "themeCSS",
    "look",
    "htmlLabels",
    "flowchart",
    "layout",
    "sequence",
    "state",
    "class",
    "er",
    "pie",
    "gantt",
    "gitGraph",
    "journey"
  ],
  "fontFamily": "\"KÉT Sans\", \"Inter\", ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
  "flowchart": {
    "htmlLabels": false,
    "useMaxWidth": false,
    "curve": "rounded",
    "nodeSpacing": 24,
    "rankSpacing": 32,
    "padding": 12,
    "diagramPadding": 12,
    "wrappingWidth": 180,
    "minNodeWidth": 80
  },
  "sequence": {
    "useMaxWidth": false,
    "actorMargin": 32,
    "actorFontSize": 13,
    "noteFontSize": 13,
    "messageFontSize": 13,
    "width": 120,
    "height": 40,
    "boxMargin": 8,
    "messageMargin": 28
  },
  "themeVariables": {
    "darkMode": false,
    "background": "{{panel-bg}}",
    "fontFamily": "\"KÉT Sans\", \"Inter\", ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "fontSize": "13px",
    "radius": 12,
    "primaryColor": "{{accent-subtle}}",
    "primaryTextColor": "{{text-main}}",
    "primaryBorderColor": "{{accent}}",
    "secondaryColor": "{{accent-subtle}}",
    "secondaryTextColor": "{{text-main}}",
    "secondaryBorderColor": "{{accent}}",
    "tertiaryColor": "{{panel-bg}}",
    "tertiaryTextColor": "{{text-main}}",
    "tertiaryBorderColor": "{{text-muted}}",
    "textColor": "{{text-main}}",
    "lineColor": "{{text-muted}}",
    "mainBkg": "{{accent-subtle}}",
    "nodeBkg": "{{accent-subtle}}",
    "nodeBorder": "{{accent}}",
    "nodeTextColor": "{{text-main}}",
    "clusterBkg": "{{panel-bg-subtle}}",
    "clusterBorder": "{{text-muted}}",
    "titleColor": "{{text-main}}",
    "defaultLinkColor": "{{text-muted}}",
    "edgeLabelBackground": "{{panel-bg-subtle}}",
    "actorBkg": "{{accent-subtle}}",
    "actorBorder": "{{accent}}",
    "actorTextColor": "{{text-main}}",
    "actorLineColor": "{{text-muted}}",
    "signalColor": "{{text-muted}}",
    "signalTextColor": "{{text-main}}",
    "labelBoxBkgColor": "{{panel-bg-subtle}}",
    "labelBoxBorderColor": "{{text-muted}}",
    "labelTextColor": "{{text-main}}",
    "loopTextColor": "{{text-main}}",
    "activationBkgColor": "{{accent-subtle}}",
    "activationBorderColor": "{{accent}}",
    "sequenceNumberColor": "{{text-main}}",
    "noteBkgColor": "{{warning-bg}}",
    "noteBorderColor": "{{warning}}",
    "noteTextColor": "{{text-main}}",
    "attributeBackgroundColorOdd": "{{panel-bg-subtle}}",
    "attributeBackgroundColorEven": "{{panel-bg}}",
    "classText": "{{text-main}}",
    "relationColor": "{{text-muted}}",
    "relationLabelColor": "{{text-main}}",
    "labelColor": "{{text-main}}",
    "altBackground": "{{panel-bg}}",
    "compositeBackground": "{{panel-bg}}",
    "compositeBorder": "{{text-muted}}",
    "cScale0": "{{accent-subtle}}",
    "cScale1": "{{positive-bg}}",
    "cScale2": "{{warning-bg}}",
    "cScale3": "{{danger-bg}}",
    "cScaleLabel0": "{{text-main}}",
    "cScaleLabel1": "{{text-main}}",
    "cScaleLabel2": "{{text-main}}",
    "cScaleLabel3": "{{text-main}}",
    "pie1": "{{accent-subtle}}",
    "pie2": "{{positive-bg}}",
    "pie3": "{{warning-bg}}",
    "pie4": "{{danger-bg}}",
    "pieStrokeColor": "{{text-muted}}",
    "pieOuterStrokeColor": "{{text-muted}}",
    "pieSectionTextColor": "{{text-main}}",
    "pieTitleTextColor": "{{text-main}}",
    "pieLegendTextColor": "{{text-main}}",
    "taskBkgColor": "{{accent-subtle}}",
    "taskBorderColor": "{{accent}}",
    "taskTextColor": "{{text-main}}",
    "taskTextOutsideColor": "{{text-main}}",
    "activeTaskBkgColor": "{{accent-subtle}}",
    "activeTaskBorderColor": "{{accent}}",
    "doneTaskBkgColor": "{{positive-bg}}",
    "doneTaskBorderColor": "{{positive}}",
    "critBkgColor": "{{danger-bg}}",
    "critBorderColor": "{{danger}}",
    "gridColor": "{{text-muted}}",
    "todayLineColor": "{{accent}}",
    "git0": "{{accent}}",
    "git1": "{{positive}}",
    "git2": "{{warning}}",
    "git3": "{{danger}}"
  },
  "themeCSS": "\n    text, tspan { font-family: \"KÉT Sans\", \"Inter\", ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important; font-size: 13px !important; }\n    text.actor { fill: {{text-main}}; stroke: none; }\n    .pieTitleText, .titleText { font-size: 16px !important; font-weight: 600; }\n    .node rect, .node polygon, .node circle, .node path, .actor, .labelBox { stroke-width: 1.25px; }\n    .node rect, rect.actor, rect.note { rx: 12px; ry: 12px; }\n    .nodeLabel, .cluster-label { font-weight: 500; }\n    .edgePath path, .flowchart-link, .messageLine0, .messageLine1 {\n      stroke-width: 1.25px; stroke-linecap: round; stroke-linejoin: round;\n    }\n    .edgeLabel rect { fill: {{panel-bg-subtle}}; stroke: {{text-muted}}; stroke-width: .5px; rx: 10px; ry: 10px; opacity: 1; }\n    .edgeLabel text { fill: {{text-main}}; }\n    .cluster rect { rx: 12px; ry: 12px; stroke-width: 1px; }\n    .node.kv-accent rect, .node.kv-accent polygon, .node.kv-accent circle, .node.kv-accent path { fill: {{accent-subtle}}; stroke: {{accent}}; }\n    .node.kv-positive rect, .node.kv-positive polygon, .node.kv-positive circle, .node.kv-positive path { fill: {{positive-bg}}; stroke: {{positive}}; }\n    .node.kv-warning rect, .node.kv-warning polygon, .node.kv-warning circle, .node.kv-warning path { fill: {{warning-bg}}; stroke: {{warning}}; }\n    .node.kv-danger rect, .node.kv-danger polygon, .node.kv-danger circle, .node.kv-danger path { fill: {{danger-bg}}; stroke: {{danger}}; }\n    .node.kv-decision rect, .node.kv-decision polygon, .node.kv-decision path { fill: {{warning-bg}}; stroke: {{warning}}; stroke-dasharray: 3 3; }\n  "
}
