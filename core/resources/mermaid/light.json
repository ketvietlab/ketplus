  "themeCSS": "\n    text, tspan { font-family: \"Inter\", ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important; font-size: 13px !important; }\n    text.actor { fill: #24262a; stroke: none; }\n    .pieTitleText, .titleText { font-size: 16px !important; font-weight: 600; }\n    .node rect, .node polygon, .node circle, .node path, .actor, .labelBox { stroke-width: 1.25px; }\n    .node rect, rect.actor, rect.note { rx: 12px; ry: 12px; }\n    .nodeLabel, .cluster-label { font-weight: 500; }\n    .edgePath path, .flowchart-link, .messageLine0, .messageLine1 {\n      stroke-width: 1.25px; stroke-linecap: round; stroke-linejoin: round;\n    }\n    .edgeLabel rect { fill: #f7f5f5; stroke: #717373; stroke-width: .5px; rx: 10px; ry: 10px; opacity: 1; }\n    .edgeLabel text { fill: #24262a; }\n    .cluster rect { rx: 12px; ry: 12px; stroke-width: 1px; }\n    .node.kv-accent rect, .node.kv-accent polygon, .node.kv-accent circle, .node.kv-accent path { fill: #eef0fb; stroke: #4f5ed0; }\n    .node.kv-positive rect, .node.kv-positive polygon, .node.kv-positive circle, .node.kv-positive path { fill: #ecf5ef; stroke: #1d5d3b; }\n    .node.kv-warning rect, .node.kv-warning polygon, .node.kv-warning circle, .node.kv-warning path { fill: #fbf3e6; stroke: #8b5c12; }\n    .node.kv-danger rect, .node.kv-danger polygon, .node.kv-danger circle, .node.kv-danger path { fill: #fef3f2; stroke: #b42318; }\n    .node.kv-decision rect, .node.kv-decision polygon, .node.kv-decision path { fill: #fbf3e6; stroke: #8b5c12; stroke-dasharray: 3 3; }\n  "
